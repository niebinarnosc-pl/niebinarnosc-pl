---
import { sanityClient } from 'sanity:client';
import DefinitionCard from '../DefinitionCard.astro';
import StoryCard from '../StoryCard.astro';
import RepresentationCard from '../RepresentationCard.astro';

const { node } = Astro.props;
const {
  contentType,
  sortBy = 'date',
  sortOrder = 'desc',
} = node;
const pinnedItems = node.pinnedItems || [];

const pinnedIds = pinnedItems.map(item => item._id);

const sortField = sortBy === 'title' ? 'title' : '_createdAt';
const ordering = `order(${sortField} ${sortOrder})`;
const pinnedFilter = pinnedIds.length > 0 ? `&& !(_id in $pinnedIds)` : '';

let remainingItems = [];
if (contentType === 'story') {
    const query = `*[_type == "story" && draft != true ${pinnedFilter}] | ${ordering} {
        ...,
        "definitions": definitions[]->{title, slug}
    }`;
    remainingItems = await sanityClient.fetch(query, { pinnedIds });
} else if (contentType === 'definition' || contentType === 'representation') {
    const query = `*[_type == "${contentType}" && draft != true ${pinnedFilter}] | ${ordering}`;
    remainingItems = await sanityClient.fetch(query, { pinnedIds });
}

const items = [...pinnedItems, ...remainingItems];
---
<div class="flex flex-col gap-4 sm:gap-8">
    {items.map(item => {
        if (item._type === 'definition') {
            return <DefinitionCard definition={item} />;
        }
        if (item._type === 'story') {
            return <StoryCard story={item} />;
        }
        if (item._type === 'representation') {
            return <RepresentationCard rep={item} />;
        }
        return null;
    })}
</div>
