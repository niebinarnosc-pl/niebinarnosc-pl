---
import { sanityClient } from 'sanity:client';
import DefinitionCard from '../DefinitionCard.astro';
import StoryCard from '../StoryCard.astro';
import RepresentationCard from '../RepresentationCard.astro';

const { node } = Astro.props;
const { contentType } = node;

let items = [];
if (contentType === 'story') {
    const query = `*[_type == "story" && draft != true] | order(date desc) {
        ...,
        "definitions": definitions[]->{title, slug}
    }`;
    items = await sanityClient.fetch(query);
} else if (contentType === 'definition') {
    items = await sanityClient.fetch(`*[_type == "definition" && draft != true] | order(priority desc)`);
} else if (contentType === 'representation') {
    items = await sanityClient.fetch(`*[_type == "representation" && draft != true] | order(date desc)`);
}
---
<div class="flex flex-col gap-4 sm:gap-8">
    {contentType === 'definition' && items.map(item => <DefinitionCard definition={item} />)}
    {contentType === 'story' && items.map(item => <StoryCard story={item} />)}
    {contentType === 'representation' && items.map(item => <RepresentationCard rep={item} />)}
</div>
