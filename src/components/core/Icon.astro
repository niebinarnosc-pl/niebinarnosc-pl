---
// Based on: blueprint/styles/iconography.md
// This is a placeholder component that renders a circle instead of a full icon.

type IconName =
  | 'arrow-right'
  | 'chart-relationship'
  | 'close'
  | 'email'
  | 'identification'
  | 'logo-facebook'
  | 'logo-instagram'
  | 'logo-twitter'
  | 'menu'
  | 'notebook'
  | 'user-simulation'
  | 'voice-activate';
export type { IconName };

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
}

const { name, class: className, size = '4/3' } = Astro.props;
---
<svg
  class:list={['icon', className]}
  style=`width: ${size}em; height: ${size}em;`
  viewBox="0 0 16 16"
  fill="currentColor"
  stroke="currentColor"
  stroke-width="0"
  xmlns="http://www.w3.org/2000/svg"
>
  <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1" fill="none" />
</svg>
