---
import TagSelector from '../../components/TagSelector.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { sanityClient } from 'sanity:client';

const { suggestionFormUrl } = Astro.props;

const categories = await sanityClient.fetch(`*[_type == "representationCategory"]{title, "slug": slug.current} | order(title asc)`);
---
<div class="flex flex-col gap-4">
    <ExternalLink href={suggestionFormUrl} class="btn btn-primary">Zaproponuj artykuł</ExternalLink>
    {categories && <TagSelector tags={categories} />}
</div>
