const iconPathHtml = iconsPaths[name];
---

{iconPathHtml ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 1 1"
    fill="currentColor"
    stroke="currentColor"
    stroke-width="0"
    role="img"
    aria-labelledby={name}
    width={size}
    height={size}
    class:list={[className]}
    style={isClipped ? {clipPath: `url(#${name}-clip)`} : {}}
    {...attrs}
  >
    {isClipped ?
      <clipPath id={`${name}-clip`} clipPathUnits="objectBoundingBox">
        <Fragment set:html={iconPathHtml} />
      </clipPath> : 
      <Fragment set:html={iconPathHtml} />
    }
  </svg>
) : (
  console.warn(`Icon "${name}" not found.`) && null
)}
