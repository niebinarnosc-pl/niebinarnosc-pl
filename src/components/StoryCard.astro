---
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import { PortableText } from 'astro-portabletext';
import Thumbnail from './Thumbnail.astro';

interface Props {
    story: any; // TODO: Replace with a proper type from Sanity
    variant?: 'full' | 'summary';
    placeholderImage?: any;
}

const { story, variant = 'full', placeholderImage } = Astro.props;
const isSummary = variant === 'summary';

const href = isSummary ? `/opowiesci#${story.slug.current}` : undefined;
---
<ContentCard href={href}>
  <div slot="thumbnail">
    <Thumbnail image={story.photo} placeholder={placeholderImage} alt={story.title} aspectRatio="square" isLightbox={true} />
  </div>
  <div slot="header">
    <h4 class="text-xl font-bold group-hover:text-purple-80 transition-colors">{story.title}</h4>
    {story.definitions && story.definitions.length > 0 && (
        <div class="flex flex-wrap gap-2">
            {story.definitions.map(def => def && isSummary ?
              <span class="badge badge-normal">{def.title}</span> :
              <a class="badge badge-normal" href={`/definicje/${def.slug.current}`}>{def.title}</a>
            )}
        </div>
    )}
  </div>
  <div slot="body">
    <PortableText value={isSummary ? story.excerpt : story.body} />
  </div>
  <div slot="footer">
    {isSummary && <span class="btn btn-secondary">Czytaj więcej <Icon name="arrow-right" /></span>}
  </div>
</ContentCard>
