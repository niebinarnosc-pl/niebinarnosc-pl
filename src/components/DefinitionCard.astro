---
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import { PortableText } from 'astro-portabletext';

const { definition } = Astro.props;
---
<ContentCard>
  <div slot="thumbnail">
    <!-- TODO: Thumbnail component -->
    <div class="aspect-square bg-gray-10 rounded-xl"></div>
  </div>
  <div slot="header">
    <h4 class="text-xl font-bold">{definition.title}</h4>
  </div>
  <div slot="body">
    <PortableText value={definition.body} />
  </div>
  <div slot="footer">
     <a href={`/definicje/${definition.slug.current}`} class="btn btn-secondary">Zobacz opowieści <Icon name="arrow-right"/></a>
  </div>
</ContentCard>
