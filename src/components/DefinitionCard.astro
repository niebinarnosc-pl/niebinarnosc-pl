---
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import { PortableText } from 'astro-portabletext';
import Thumbnail from './Thumbnail.astro';

interface Props {
    definition: any; // TODO: Replace with a proper type from Sanity
    variant?: 'full' | 'summary';
    singleDefinition?: boolean;
    placeholderImage?: any;
}

const { definition, variant = 'full', singleDefinition = false, placeholderImage } = Astro.props;
const isSummary = variant === 'summary';

const href = isSummary ? `/definicje/${definition.slug.current}` : undefined;

const footerLink = singleDefinition ? "/definicje/" : `/definicje/${definition.slug.current}`;
const footerText = singleDefinition ? "Zobacz inne definicje" : "Zobacz opowieści";
---
<ContentCard href={href}>
  <div slot="thumbnail">
    <Thumbnail image={definition.photo} placeholder={placeholderImage} alt={definition.title} isSquare isLightbox={!isSummary} />
  </div>
  <div slot="header">
    <h3 class="group-hover:text-purple-80 transition-colors">{definition.title}</h3>
  </div>
  <div slot="body">
    <PortableText value={isSummary ? definition.excerpt : definition.body} />
  </div>
  <div slot="footer">
    {!isSummary && <a href={footerLink} class="btn btn-secondary ml-auto">{footerText} <Icon name="arrow-right"/></a>}
  </div>
</ContentCard>
