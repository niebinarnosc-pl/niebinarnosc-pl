---
---
<div
  class="fixed inset-0 z-[999] bg-black/80 flex items-center justify-center p-4"
  x-show="lightboxOpen"
  x-transition
  @click="lightboxOpen = false"
  @keydown.escape.window="lightboxOpen = false"
  role="dialog"
  aria-modal="true"
  aria-label="Image lightbox"
  x-trap.inert.noscroll="lightboxOpen"
  style="display: none;"
>
  <img :src="lightboxImage" :alt="lightboxAlt" class="max-w-[85vw] max-h-[85vh] w-full h-full object-contain">
</div>
