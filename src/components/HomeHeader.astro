---
import quote from '../assets/quote.svg';
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';
---
<header class="relative mx-4 flex flex-col gap-4">
    <img src={quote.src} alt="Cudzysłów" class="absolute top-0 left-0 opacity-15 max-w-[30%]" />
    <h1 class="relative text-center mx-auto mb-8 text-purple-dark-2">
        <strong class="text-inherit text-[1.375em]">Niebinarność</strong> jest dziobakiem wśród&nbsp;płci.<br/>Ni to wydra, ni to kaczka, still&nbsp;cute.
    </h1>
    <div class="flex justify-center">
        <ExternalLink class="btn btn-primary" href="https://docs.google.com/forms/d/e/1FAIpQLSc42Nvv4n8X80YckrCSUzKZphsVoKCqXkeHNgIeSjMKTjcdUA/viewform?usp=sf_link">
            Zaproponuj slogan
        </ExternalLink>
    </div>
    <div class="text-purple-60 my-3 flex justify-center sm:justify-end">
        <ExternalLink href="https://www.instagram.com/niebinarnosc.pl/" class="p-3 sm:p-1"><Icon name="logo-instagram" size="2em" /></ExternalLink>
        <ExternalLink href="https://www.facebook.com/niebinarnoscpl" class="p-3 sm:p-1"><Icon name="logo-facebook" size="2em" /></ExternalLink>
    </div>
</header>
