---
import { urlFor } from '../lib/image';
import type { SanityImageSource } from '@sanity/image-url/lib/types/types';

interface Props {
  image?: SanityImageSource & { alt?: string, asset?: { altText?: string }, hotspot?: any, crop?: any };
  placeholder?: SanityImageSource;
  alt?: string;
  isSquare?: boolean;
  isLightbox?: boolean;
}

const { image, placeholder, alt = '', isSquare = false, isLightbox = true } = Astro.props;

const imageSource = image || placeholder;
const imageAlt = image?.alt || image?.asset?.altText || alt;

let imageUrlBuilder = imageSource ? urlFor(imageSource).auto('format').width(360) : null;

const imageUrl = imageUrlBuilder ? imageUrlBuilder.url() : null;
const fullImageUrl = image ? urlFor(image.asset).width(1600).auto('format').url() : null;
const clickHandler = isLightbox && fullImageUrl ? `$dispatch('open-lightbox', { image: '${fullImageUrl}', alt: '${imageAlt}' })` : ''
---
{imageUrl ? (
  <div class:list={["relative w-full", isSquare ? 'aspect-square' : '']}>
    <img
      src={imageUrl}
      alt={imageAlt}
      loading="lazy"
      class:list={[
        "rounded-xl object-cover w-full h-full",
        clickHandler && "cursor-pointer"
      ]}
      @click={clickHandler}
    />
  </div>
) : (
  <div class:list={["bg-gray-10 rounded-xl", isSquare ? 'aspect-square' : '']}></div>
)}
