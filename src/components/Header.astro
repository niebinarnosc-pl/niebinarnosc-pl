---
import { urlFor } from '../lib/image';
import { getLinkUrl } from '../lib/links';
import Icon from './Icon.astro';

const { siteSettings } = Astro.props;
const pathname = Astro.url.pathname;

const logo = siteSettings?.logo;
const logoFull = siteSettings?.logoFull;
const navLinks = siteSettings?.headerNavLinks || [];
---
<header 
    x-data="{ prevY: 0, isVisible: true, mobileNavExpanded: false }" 
    @scroll.window.throttle.50ms="
        newY = window.scrollY;
        isVisible = newY < prevY;
        if (!isVisible) { mobileNavExpanded = false };
        prevY = newY;
    "
    :class="!isVisible ? '-top-[7rem]' : 'top-0'"
    class="sticky w-full z-50 transition-top duration-200 h-0"
>
    <div class="mx-auto max-w-[72rem] pt-4 px-4 sm:pt-6 sm:px-6">
        <!-- Standard Header (Desktop) -->
        <section class="card hidden lg:block px-6 py-5">
            <div class="flex items-center justify-between">
                <a href="/">
                    <img class="h-6" src={urlFor(logoFull).url()} alt="niebinarnosc.pl" />
                </a>
                <nav class="flex justify-around gap-7">
                    {navLinks.map(({ link, icon }) => {
                        const href = getLinkUrl(link);
                        const isActive = pathname === href || (href.length > 1 && pathname.startsWith(href));
                        return <a href={href} class:list={["no-underline hover:text-indigo fake-bold font-bold-hover-no-shift", isActive ? 'text-indigo font-bold' : 'text-purple-dark-1']} data-text={link.title}>{link.title}</a>
                    })}
                </nav>
            </div>
        </section>

        <!-- Mobile Header (Top) -->
        <section 
            class="card lg:hidden flex flex-col py-4 px-6"
            @click.outside="mobileNavExpanded = false"
        >
            <div class="flex items-center justify-between h-8">
                <a href="/" class="h-full">
                    <img class="h-full" src={urlFor(logo).url()} alt="niebinarnosc.pl"/>
                </a>
                <button 
                    class="text-purple-dark-1 text-2xl sm:text-[2rem]" 
                    @click="mobileNavExpanded = !mobileNavExpanded" 
                    aria-label="Menu"
                >
                    <Icon name="menu" size={"1.3em"}/>
                </button>
            </div>
            <div 
                x-show="mobileNavExpanded"
                x-transition:enter="transition-[grid-template-rows] duration-200"
                x-transition:enter-start="grid-rows-[0fr]"
                x-transition:enter-end="grid-rows-[1fr]"
                x-transition:leave="transition-[grid-template-rows] duration-200"
                x-transition:leave-start="grid-rows-[1fr]"
                x-transition:leave-end="grid-rows-[0fr]"
                class="grid"
            >
                <nav class="overflow-hidden pl-8">
                    <div class="h-3"></div>
                    {navLinks.map(({ link, icon }) => {
                        const href = getLinkUrl(link);
                        const isActive = pathname === href || (href.length > 1 && pathname.startsWith(href));
                        return (
                            <a href={href} @click="mobileNavExpanded = false" class:list={["text-purple-dark-1 text-lg sm:text-2xl py-5 w-min flex items-center gap-2 whitespace-nowrap", { 'underline font-bold': isActive }]}>
                                <Icon name={icon} size={"1.3em"} />
                                <span>{link.title}</span>
                            </a>
                        )
                    })}
                </nav>
            </div>
        </section>
    </div>
</header>
