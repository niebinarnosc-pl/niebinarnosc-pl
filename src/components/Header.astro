---
import logo from '../assets/logo-full.svg';
import { navLinks } from '../lib/navLinks';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;
---
<header 
    x-data="{ atTop: true, prevY: 0, isVisible: true, mobileNavExpanded: false }" 
    @scroll.window.throttle.100ms="
        newY = window.scrollY;
        atTop = newY <= 10;
        isVisible = atTop || newY < prevY;
        if (!isVisible) { mobileNavExpanded = false };
        prevY = newY;
    "
    :class="{ '!-top-28': !isVisible && !atTop }"
    class="sticky top-0 z-50 transition-all duration-200"
>
    <div class="mx-auto max-w-[72rem] pt-6 px-6">
        <!-- Standard Header (Desktop) -->
        <section class="card hidden lg:block px-6 py-5">
            <div class="flex items-center justify-between">
                <a href="/">
                    <img class="h-6" src={logo.src} alt="niebinarnosc.pl" />
                </a>
                <nav class="flex justify-around gap-7">
                    {navLinks.map(({ text, route }) => {
                        const isActive = pathname === route || (route.length > 1 && pathname.startsWith(route));
                        return <a href={route} class:list={["font-medium text-purple-dark-1 no-underline hover:text-indigo fake-bold font-bold-hover-no-shift", { 'text-indigo font-bold': isActive }]} data-text={text}>{text}</a>
                    })}
                </nav>
            </div>
        </section>

        <!-- Mobile Header (Top) -->
        <section 
            class="lg:hidden flex flex-col p-4 sm:p-6 bg-white [box-shadow:0_4px_0_0_var(--btn-shadow-color)]" 
            style="--btn-shadow-color: var(--color-gray-20);"
            @click.outside="mobileNavExpanded = false"
        >
            <div class="flex items-center justify-between h-8">
                <a href="/" class="h-full">
                    <img class="h-full" src={logo.src} alt="niebinarnosc.pl"/>
                </a>
                <button 
                    class="text-purple-dark-1 text-2xl sm:text-[2rem]" 
                    @click="mobileNavExpanded = !mobileNavExpanded" 
                    aria-label="Menu"
                >
                    <Icon name="menu" />
                </button>
            </div>
            <div 
                x-show="mobileNavExpanded"
                x-transition:enter="grid-rows-[1fr] transition-[grid-template-rows] duration-200"
                x-transition:leave="grid-rows-[0fr] transition-[grid-template-rows] duration-200"
                class="grid grid-rows-[0fr]"
            >
                <nav class="overflow-hidden pl-8">
                    <div class="h-3"></div>
                    {navLinks.map(({ text, route, icon }) => {
                        const isActive = pathname === route || (route.length > 1 && pathname.startsWith(route));
                        return (
                            <a href={route} @click="mobileNavExpanded = false" class:list={["text-purple-dark-1 text-lg sm:text-2xl py-5 w-min font-medium flex items-center gap-2 whitespace-nowrap", { 'underline font-bold': isActive }]}>
                                <Icon name={icon} />
                                <span>{text}</span>
                            </a>
                        )
                    })}
                </nav>
            </div>
        </section>
    </div>
</header>

<!-- Mobile Bottom Buttons -->
<section class="sticky bottom-0 z-40 lg:hidden bg-white border-t border-purple-60 px-2">
    <nav class="w-full flex justify-center">
        {navLinks.slice(0, 5).map(({ text, route, icon }) => {
            const isActive = pathname === route || (route.length > 1 && pathname.startsWith(route));
            return (
                <a href={route} class:list={["flex flex-col items-center gap-[0.25em] p-[0.5em_0.75em] text-gray-80 text-xs sm:text-lg leading-normal", { 'text-purple-100 bg-purple-5 font-bold': isActive }]}>
                    <Icon name={icon} class="text-[1.5em]" />
                    <span>{text}</span>
                </a>
            )
        })}
    </nav>
</section>
