---
interface Props {
  variant?: 'normal' | 'selected' | 'error';
  href?: string;
  class?: string;
}

const { variant = 'normal', href, class: className } = Astro.props;

const Tag = href ? 'a' : 'span';

const baseClasses = 'inline-flex h-8 px-3 py-1 justify-center items-center whitespace-nowrap text-sm font-medium rounded-full border-none transition-colors duration-100 no-underline';

const variantClasses = {
    normal: 'bg-purple-10 text-indigo hover:bg-purple-20',
    selected: 'bg-indigo text-white',
    error: 'bg-[#ffe6e6] text-[#ff2222]'
};
---
<Tag href={href} class:list={[baseClasses, variantClasses[variant], className]}>
    <slot />
</Tag>
