---
import logo from '../../assets/logo.svg';
import NavLink from './NavLink.astro';
import { navLinks } from '../../lib/navLinks';
---
<section class="hidden lg:block bg-white px-6 py-5 btn-3d" style="--btn-shadow-color: var(--color-purple-60);">
    <div class="flex items-center justify-between">
        <a href="/" class="h-6">
            <img src={logo.src} alt="niebinarnosc.pl" class="h-full" />
        </a>
        <nav class="flex justify-center gap-8 text-purple-dark-1">
            {navLinks.map(link => <NavLink text={link.text} route={link.route} class="hover:text-indigo hover:font-bold hover:no-underline [&.active]:text-indigo [&.active]:font-bold" />)}
        </nav>
    </div>
</section>
