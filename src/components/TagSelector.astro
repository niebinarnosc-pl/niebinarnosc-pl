---
interface Tag {
  title: string;
  slug: string;
}
interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---
<div class="flex gap-3 flex-wrap">
    <button type="button" @click="activeCategory = 'all'" class="badge" :class="activeCategory === 'all' ? 'badge-selected' : 'badge-normal'">Wszystko</button>
    {tags.map(tag => (
        <button type="button" @click={`activeCategory = '${tag.slug}'`} class="badge" :class={`activeCategory === '${tag.slug}' ? 'badge-selected' : 'badge-normal'`}>
            {tag.title}
        </button>
    ))}
</div>
