---
import slugify from "../lib/slugify";

interface Props {
  basePath: string;
  tags: string[];
  active?: string;
}

const { basePath, tags, active } = Astro.props;
---
<div class="flex gap-3 flex-wrap">
    <a href={basePath} class:list={["badge", !active ? 'badge-selected' : 'badge-normal']}>Wszystko</a>
    {tags.map(tag => (
        <a href={`${basePath}/${slugify(tag)}`} class:list={["badge", active === tag ? 'badge-selected' : 'badge-normal']}>
            {tag}
        </a>
    ))}
</div>
