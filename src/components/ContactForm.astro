---
import ExternalLink from './ExternalLink.astro';
import Icon from './Icon.astro';

const { siteSettings } = Astro.props;
const email = siteSettings?.email;
---
<section class="contact-form" id="kontakt">
    <h2 class="h2-decorated">Kontakt</h2>
    <div class="flex flex-col lg:flex-row gap-6">
        <div class="flex-1">
            <p>Masz do nas pytania? Szukasz pomocy? Napisz do nas na maila lub wypełnij formularz.</p>
            {email && (
                <p>
                    <ExternalLink href={`mailto:${email}`} class="flex items-center gap-3 text-purple-100 font-medium">
                        <Icon name="email" size="1.3em"/>{email}
                    </ExternalLink>
                </p>
            )}
        </div>
        <div class="flex-1" x-data="contactForm()">
            <div x-show="success" style="display: none;" class="p-4 rounded-xl bg-purple-10 text-purple-100">
                <p class="font-bold">Dziękujemy za wiadomość!</p>
                <p>Odezwiemy się najszybciej jak to możliwe.</p>
            </div>

            <form x-show="!success" name="Kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-3 lg:max-w-[35.25rem] w-full" @submit.prevent="submit">
                <input type="hidden" name="form-name" value="Kontakt"/>
                <input type="hidden" name="subject" data-remove-prefix />
                <label class="group flex items-center gap-3 p-3 bg-white rounded-xl border border-gray-40 has-[:focus]:outline has-[:focus]:outline-1 has-[:focus]:outline-purple-100 text-gray-80 has-[:focus]:text-purple-100">
                    <Icon name="email" size="1.3em"/>
                    <input :disabled="submitting" type="email" name="email" placeholder="E-mail, np. nazwa@gmail.com" required class="p-0 m-0 border-none rounded-none w-full focus:outline-none bg-transparent"/>
                </label>
                <textarea :disabled="submitting" name="text" placeholder="Tutaj wpisz swoją wiadomość" required class="p-3 bg-white rounded-xl border border-gray-40 h-32 focus:outline focus:outline-1 focus:outline-purple-100"></textarea>
                <label class="hidden">Nie wypełniaj, jeśli jesteś niebinarna_y:<input name="bot-field"/></label>

                <div x-show="error" style="display: none;" class="p-3 rounded-xl bg-[#ffe6e6] text-[#ff2222]" x-text="errorMessage"></div>

                <button :disabled="submitting" class="btn btn-primary ml-auto" type="submit">
                    <span x-show="submitting" style="display: none;">Wysyłanie...</span>
                    <span x-show="!submitting">Wyślij wiadomość</span>
                </button>
            </form>
        </div>
    </div>
</section>
<script is:inline>
    function contactForm() {
        return {
            submitting: false,
            success: false,
            error: false,
            errorMessage: 'Wystąpił błąd podczas wysyłania formularza. Spróbuj ponownie później.',
            submit(event) {
                this.submitting = true;
                this.error = false;
                const form = event.target;
                const formData = new FormData(form);

                const email = formData.get('email');
                formData.set('subject', `Wiadomość od ${email}`);

                fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(formData).toString()
                })
                .then(response => {
                    if (response.ok) {
                        this.success = true;
                        form.reset();
                    } else {
                        throw new Error('Form submission failed');
                    }
                })
                .catch(() => {
                    this.error = true;
                })
                .finally(() => {
                    this.submitting = false;
                });
            }
        };
    }
</script>
