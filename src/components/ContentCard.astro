---
import Card from './Card.astro';
---
<Card class="p-0 sm:p-0">
  <article class="flex flex-col lg:flex-row gap-6 p-4 sm:p-6">
    <div class="hidden lg:block w-[9rem] shrink-0">
      <slot name="thumbnail" />
    </div>
    <div class="flex-1 flex flex-col gap-4">
      <header class="flex gap-4">
        <div class="lg:hidden w-[4.5rem] shrink-0">
          <slot name="thumbnail" />
        </div>
        <div class="flex-1 flex flex-col gap-2">
            <slot name="header" />
        </div>
      </header>
      <div class="prose max-w-none text-black">
        <slot name="body" />
      </div>
      <footer class="mt-auto">
        <slot name="footer" />
      </footer>
    </div>
  </article>
</Card>
