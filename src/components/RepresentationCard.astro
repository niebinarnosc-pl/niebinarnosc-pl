---
import ContentCard from './ContentCard.astro';
import slugify from '../lib/slugify';
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
    rep: any; // TODO: Replace with a proper type from Sanity
    variant?: 'full' | 'summary';
    placeholderImage?: any;
}

const { rep, variant = 'full', placeholderImage } = Astro.props;
const isSummary = variant === 'summary';

const href = isSummary ? `/reprezentacja#${rep.slug.current}` : undefined;
---
<ContentCard href={href}>
    <div slot="thumbnail">
        <Thumbnail image={rep.photo} placeholder={placeholderImage} alt={rep.title} isLightbox={!isSummary} />
    </div>
    <Fragment slot="header">
        <h3 class="group-hover:text-purple-80 transition-colors">{rep.title}</h3>
        {rep.authors && !isSummary && <p class="m-0">{rep.authors.map(a => a.name).join(', ')}</p>}
        {rep.category && (isSummary ?
            <span class="badge badge-normal mr-auto">{rep.category}</span> :
            <a class="badge badge-normal mr-auto" href={`/reprezentacja/${slugify(rep.category)}`}>{rep.category}</a>
        )}
    </Fragment>
    <div slot="body">
        {isSummary ? (
            <p>{rep.storyDescription}</p>
        ) : (
            <>
                <h4 class="font-bold">Opis fabuły</h5>
                <p>{rep.storyDescription}</p>
                <h4 class="font-bold">Reprezentacja</h5>
                <p>{rep.representationDescription}</p>
            </>
        )}
    </div>
</ContentCard>
