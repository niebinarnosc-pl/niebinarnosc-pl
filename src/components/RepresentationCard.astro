---
import ContentCard from './ContentCard.astro';
import Icon from './Icon.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
    rep: any; // TODO: Replace with a proper type from Sanity
    variant?: 'full' | 'summary';
}

const { rep, variant = 'full' } = Astro.props;
const isSummary = variant === 'summary';

const href = isSummary ? `/reprezentacja#${rep.slug.current}` : undefined;
---
<ContentCard
    id={rep.slug.current}
    href={href}
    x-show={!isSummary ? `activeCategory === 'all' || activeCategory === '${rep.category?.slug.current || ''}'` : ''}
>
    <div slot="thumbnail">
        <Thumbnail image={rep.photo} alt={rep.title} isLightbox={!isSummary} />
    </div>
    <Fragment slot="header">
        <h3 class="group-hover:text-purple-80 transition-colors">{rep.title}</h3>
        {rep.authors && !isSummary && <p class="m-0">{rep.authors.map(a => a.name).join(', ')}</p>}
        {rep.category && (isSummary ?
            <span class="badge badge-normal mr-auto">{rep.category.title}</span> :
            <button class="badge badge-normal mr-auto" @click={`activeCategory = '${rep.category.slug.current}'`}>{rep.category.title}</button>
        )}
    </Fragment>
    <div slot="body">
        {isSummary ? (
            <p>{rep.storyDescription}</p>
        ) : (
            <>
                <h4 class="font-bold">Opis fabuły</h5>
                <p>{rep.storyDescription}</p>
                <h4 class="font-bold">Reprezentacja</h5>
                <p>{rep.representationDescription}</p>
            </>
        )}
    </div>
    <div slot="footer">
        {isSummary && <button class="sm:hidden btn btn-secondary ml-auto">Czytaj więcej <Icon name="arrow-right"/></button>}
    </div>
</ContentCard>
