---
import { urlFor } from '../lib/image';
import Icon from './Icon.astro';
import ExternalLink from './ExternalLink.astro';

const { siteSettings } = Astro.props;
const logoFull = siteSettings?.logoFull;
const socialLinks = siteSettings?.socialLinks || [];
const email = siteSettings?.email;
---
<footer class="bg-purple-dark-2 text-purple-5">
    <div class="w-full max-w-[72rem] mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
        <a href="/">
            <img class="h-8" src={urlFor(logoFull).url()} alt="niebinarnosc.pl" />
        </a>
        <div class="flex flex-col gap-3">
            <div class="flex gap-4 justify-center sm:justify-start sm:ml-[-3px]">
                {socialLinks.map(({ url, icon }) => (
                    <ExternalLink href={url} class="p-2 sm:p-0">
                        <Icon name={icon} size="1.75em" />
                    </ExternalLink>
                ))}
            </div>
            <a href="/#kontakt" class="font-bold text-purple-20 hover:underline">Napisz do nas</a>
            {email && (
                <ExternalLink href={`mailto:${email}`} class="flex items-center justify-center sm:justify-start gap-3 text-purple-20 hover:underline">
                    <Icon name="email" size="1.5em" />
                    <span>{email}</span>
                </ExternalLink>
            )}
        </div>
    </div>
</footer>
