---
import HomeNavItem from './HomeNavItem.astro';
import { getLinkUrl } from '../lib/links';

const { siteSettings } = Astro.props;
const navRows = siteSettings?.homeNavRows || [];
---
<nav class="flex flex-col gap-4 sm:gap-6 mb-16 w-full">
    {navRows.map(row => (
        <div class="flex flex-col sm:flex-row flex-wrap gap-4 sm:gap-6 w-full">
            {row.links.map(item => (
                <HomeNavItem 
                    to={getLinkUrl(item.link)}
                    color={item.color}
                    icon={item.icon}
                    heading={item.link.title}
                    desc={item.description}
                />
            ))}
        </div>
    ))}
</nav>
