---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'
import TagSelector from '../../components/TagSelector.astro';
import RepresentationCard from '../../components/RepresentationCard.astro';
import ExternalLink from '../../components/ExternalLink.astro';

const representations = await sanityClient.fetch(`*[_type == "representation" && draft != true] | order(date desc)`);
const allCategories = await sanityClient.fetch(`*[_type == "representation" && defined(category) && draft != true].category`);
const uniqueCategories = [...new Set(allCategories as string[])];
---
<Layout>
  <header class="flex flex-col gap-4 mb-8">
    <h1 class="text-xl sm:text-3xl text-purple-dark-2">Reprezentacja</h1>
    <p class="max-w-2xl font-bold text-gray-60 mb-0">Zaproponuj nam swoją pozycję z odniesieniami w kulturze.</p>
    <ExternalLink href="https://forms.gle/cuWkGHvyWbbfbsd16" class="btn btn-primary">Zaproponuj artykuł</ExternalLink>
    {uniqueCategories && <TagSelector basePath="/reprezentacja" tags={uniqueCategories} active={undefined} />}
  </header>
  <div class="content-container">
      {representations.map(rep => <RepresentationCard rep={rep} />)}
  </div>
</Layout>
