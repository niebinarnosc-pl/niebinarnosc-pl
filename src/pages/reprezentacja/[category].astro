---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'
import TagSelector from '../../components/TagSelector.astro';
import RepresentationCard from '../../components/RepresentationCard.astro';
import ExternalLink from '../../components/ExternalLink.astro';

const categorySlug = Astro.url.searchParams.get('category');

const query = `*[_type == "representation" && draft != true ${categorySlug ? '&& category->slug.current == $categorySlug' : ''}] {
    ...,
    category->{title, "slug": slug.current}
} | order(title asc)`;
const params = { categorySlug };

const representations = await sanityClient.fetch(query, params);
const allCategories = await sanityClient.fetch(`*[_type == "category"]{title, "slug": slug.current} | order(title asc)`);
---
<Layout>
  <header class="flex flex-col gap-4 mb-8">
    <h1 class="text-xl sm:text-3xl text-purple-dark-2">Reprezentacja</h1>
    <p class="max-w-2xl font-bold text-gray-60 mb-0">Zaproponuj nam swoją pozycję z odniesieniami w kulturze.</p>
    <ExternalLink href="https://forms.gle/cuWkGHvyWbbfbsd16" class="btn btn-primary">Zaproponuj artykuł</ExternalLink>
    {allCategories && <TagSelector basePath="/reprezentacja" tags={allCategories} active={categorySlug} />}
  </header>
  <div class="content-container">
      {representations.map(rep => <RepresentationCard rep={rep} />)}
  </div>
</Layout>
