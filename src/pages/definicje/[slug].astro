---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from 'astro-portabletext';
import StoryCard from '../../components/StoryCard.astro';
import DefinitionCard from '../../components/DefinitionCard.astro';
import AlertCardWidget from '../../components/page/AlertCardWidget.astro';

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`*[_type == "definition" && defined(slug.current) && draft != true].slug.current`);
    return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const query = `*[_type == "definition" && slug.current == $slug && draft != true][0]{
  ...,
  "plainBody": pt::text(body),
  "relatedStories": *[_type == "story" && references(^._id) && draft != true] {
    ...,
    "definitions": definitions[]->{title, slug}
  }
}`;

const definition = await sanityClient.fetch(query, { slug });

if (!definition) {
    return Astro.redirect('/404');
}
---
<Layout page={definition}>
  <header class="flex flex-col gap-4 mb-8">
    <h1 class="text-xl sm:text-3xl text-purple-dark-2">{definition.title}</h1>
  </header>
  
  <article class="content-container">
    <DefinitionCard definition={definition} singleDefinition />
  </article>
  
  <section>
    <h2 class="h2-decorated">Opowieści</h2>
    {definition.relatedStories && definition.relatedStories.length > 0 ? (
      <div class="content-container flex flex-col gap-8 sm:gap-16">
        {definition.relatedStories.map(story => <StoryCard story={story} />)}
      </div>
    ) : (
      <div class="content-container">
        <h3 class="font-bold mb-4">Brak opowieści :(</h4>
        <p>Niestety, nikt nie podzielił się jeszcze swoją opowieścią związaną z tym terminem.</p>
        <p>Chcesz być pierwsz_? <a href="https://forms.gle/TtUto7L4xXnts4Lg6" class="font-bold text-purple-60">Napisz do nas.</a></p>
      </div>
    )}
  </section>

  <AlertCardWidget
    heading="Opowiedz nam swoją historię"
    body="Jesteś osobą niebinarną? Chcesz, aby Twoja opowieść pojawiła się na stronie? Podziel się z nami swoją historią korzystając z formularza."
    buttonTitle="Napisz nam o sobie"
    buttonUrl="https://forms.gle/TtUto7L4xXnts4Lg6"
  />
</Layout>
