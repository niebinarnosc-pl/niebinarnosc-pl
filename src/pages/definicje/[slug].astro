---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from 'astro-portabletext';
import StoryCard from '../../components/StoryCard.astro';
import ContactCard from '../../components/ContactCard.astro';

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`*[_type == "definition" && defined(slug.current) && draft != true].slug.current`);
    return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const query = `*[_type == "definition" && slug.current == $slug && draft != true][0]{
  ...,
  "relatedStories": *[_type == "story" && references(^._id) && draft != true]
}`;

const definition = await sanityClient.fetch(query, { slug });

if (!definition) {
    return Astro.redirect('/404');
}
---
<Layout>
    <main class="w-full max-w-[72rem] mx-auto px-4 sm:px-6 mt-26 sm:mt-30 pb-6 sm:pb-11">
      <header class="flex flex-col gap-4 mb-8">
        <h1 class="text-xl sm:text-3xl text-purple-dark-2">{definition.title}</h1>
        {definition.titleEn && <p class="text-lg sm:text-2xl text-gray-60">({definition.titleEn.toLowerCase()})</p>}
      </header>
      
      <article class="prose max-w-none mb-8 bg-white p-4 sm:p-6 rounded-xl">
        <PortableText value={definition.body} />
      </article>
      
      <section>
        <h2 class="h2-decorated">Opowieści</h2>
        {definition.relatedStories && definition.relatedStories.length > 0 ? (
          <div class="flex flex-col gap-4">
            {definition.relatedStories.map(story => <StoryCard story={story} />)}
          </div>
        ) : (
          <div class="bg-white p-6 rounded-xl">
            <h4 class="text-xl font-bold">Brak opowieści :(</h4>
            <p>Niestety, nikt nie podzielił się jeszcze swoją opowieścią związaną z tym terminem.</p>
            <ContactCard />
          </div>
        )}
      </section>
    </main>
</Layout>
