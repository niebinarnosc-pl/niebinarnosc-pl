---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import HomeHeader from '../components/HomeHeader.astro';
import HomeNav from '../components/HomeNav.astro';
import ContactForm from '../components/ContactForm.astro';

const news = await sanityClient.fetch(`*[_type in ["story", "representation", "definition"] && draft != true] | order(date desc, _createdAt desc) [0...3]`);
---
<Layout>
  <div class="w-full max-w-[72rem] mx-auto px-4 sm:px-6">
    <HomeHeader />
    <HomeNav />
    <section>
      <h2 class="h2-decorated">Niusy</h2>
      <div class="flex flex-col gap-4">
        <pre>{JSON.stringify(news, null, 2)}</pre>
      </div>
    </section>
    <ContactForm />
  </div>
</Layout>
