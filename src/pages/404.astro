---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404">
    <header class="text-center">
        <h1 class="text-8xl sm:text-9xl text-purple-dark-2 leading-none my-4">404</h1>
        <p class="text-4xl sm:text-5xl max-w-full">Nie znaleziono</p>
    </header>
    <div class="bg-white p-4 mt-8">
        <blockquote class="text-lg italic">
            "Tu? Tu <em>nic</em> nie ma. Pójdzie do pokoju numer 301, dostanie tam numerek i ustawi się w kolejce do pokoju numer 200, tak? Tam powiedzą co dalej, do widzenia.  ... DRZWI! to jest PRXYCHODNIA nie SUPERMARKET!1"
        </blockquote>
        <cite class="block text-right mt-4">Miła pani z pokoju 404 :)</cite>
    </div>
</Layout>
