---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'

const definitions = await sanityClient.fetch(`*[_type == "definition" && draft != true] | order(priority desc)`);
---
<Layout>
  <main class="container mx-auto p-4">
    <header>
      <h1>Definicje</h1>
      <p>Czym jest niebinarność i inne.</p>
    </header>
    <pre>{JSON.stringify(definitions, null, 2)}</pre>
  </main>
</Layout>
