---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'
import DefinitionCard from '../components/features/cards/DefinitionCard.astro';

const definitions = await sanityClient.fetch(`*[_type == "definition" && draft != true] | order(priority desc)`);
---
<Layout>
  <main class="w-full max-w-[72rem] mx-auto px-4 sm:px-6 mt-26 sm:mt-30 pb-6 sm:pb-11">
    <header class="flex flex-col gap-4 mb-8">
      <h1 class="text-xl sm:text-3xl text-purple-dark-2">Definicje</h1>
      <p class="max-w-2xl font-bold text-gray-60">Czym jest niebinarność i inne.</p>
    </header>
    <div class="flex flex-col gap-4">
        {definitions.map(def => <DefinitionCard definition={def} />)}
    </div>
  </main>
</Layout>
