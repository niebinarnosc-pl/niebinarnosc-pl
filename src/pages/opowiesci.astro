---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'
import StoryCard from '../components/StoryCard.astro';
import ContactCard from '../components/ContactCard.astro';

const query = `*[_type == "story" && draft != true] | order(date desc) {
    ...,
    "definitions": definitions[]->{title, slug}
}`;
const stories = await sanityClient.fetch(query);
---
<Layout>
  <main class="w-full max-w-[72rem] mx-auto px-4 sm:px-6 mt-26 sm:mt-30 pb-6 sm:pb-11">
    <header class="flex flex-col gap-4 mb-8">
      <h1 class="text-xl sm:text-3xl text-purple-dark-2">Opowieści</h1>
      <p class="max-w-2xl font-bold text-gray-60">Nasze opowieści o płciowości.</p>
    </header>
    <ContactCard />
    <div class="flex flex-col gap-4">
        {stories.map(story => <StoryCard story={story} />)}
    </div>
  </main>
</Layout>
