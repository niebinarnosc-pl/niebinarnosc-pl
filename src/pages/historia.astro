---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client'
import { PortableText } from 'astro-portabletext';

const page = await sanityClient.fetch(`*[_type == "page" && slug.current == "historia"][0]`);
---
<Layout>
  <main class="container mx-auto p-4 prose">
    <header>
      <h1>{page.title}</h1>
      <p>Jaka jest nasza historia? Dowiedz się więcej o niebinarności.</p>
    </header>
    <article>
        <PortableText value={page.body} />
    </article>
  </main>
</Layout>
