---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { PortableText } from 'astro-portabletext';
import Columns from '../components/portabletext/Columns.astro';
import ImageColumn from '../components/portabletext/ImageColumn.astro';
import HorizontalRule from '../components/portabletext/HorizontalRule.astro';
import ContentListing from '../components/portabletext/ContentListing.astro';

// Pre-body components
import ContactCardWidget from '../components/page/ContactCardWidget.astro';
import RepresentationHeaderWidget from '../components/page/RepresentationHeaderWidget.astro';

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`*[_type == "page" && defined(slug.current)].slug.current`);
    return slugs.map((slug: string) => ({ params: { slug } }));
}

const { slug } = Astro.params;

const query = `*[_type == "page" && slug.current == $slug][0]{
    ...,
    body[]{
        ...,
        _type == "contentListing" => {
            "pinnedItems": pinnedItems[]->{
                ...,
                _type == "story" => {
                    "definitions": definitions[]->{title, slug}
                }
            }
        }
    }
}`;
const page = await sanityClient.fetch(query, { slug });

if (!page) {
    return Astro.redirect('/404');
}

const portableTextComponents = {
    type: {
        columns: Columns,
        imageColumn: ImageColumn,
        hr: HorizontalRule,
        contentListing: ContentListing,
    }
}

const preBodyComponents = {
    contactCardWidget: ContactCardWidget,
    representationHeaderWidget: RepresentationHeaderWidget,
}
---
<Layout>
  <header class="flex flex-col gap-4 mb-8">
    <h1 class="text-xl sm:text-3xl text-purple-dark-2">{page.title}</h1>
    {page.subheading && <p class="font-bold text-gray-60">{page.subheading}</p>}
  </header>
  
  {page.preBody && page.preBody.map(widget => {
      const Component = preBodyComponents[widget._type];
      return <Component widget={widget} />;
  })}
  
  {page.body && page.body.length > 0 &&
    <article class="content-container">
      <PortableText value={page.body} components={portableTextComponents} />
    </article>
  }
</Layout>
